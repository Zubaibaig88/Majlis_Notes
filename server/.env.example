# Copy this file to .env and fill it in.

# Port the server listens on
PORT=8787

# A long secret. Put the SAME value in the extension Settings and the dashboard.
MAJLIS_TOKEN=change-me-to-a-long-random-secret

# Claude API key for AI summaries (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: turn uploaded recordings into text.
# Deepgram is best (speaker names + Arabic). OpenAI Whisper also works.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
OPENAI_API_KEY=

# Optional: Google Calendar integration
# Get credentials from https://console.cloud.google.com
# Create OAuth 2.0 credentials and set Redirect URI to http://localhost:8787/api/calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8787/api/calendar/callback
