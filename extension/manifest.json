{
  "manifest_version": 3,
  "name": "Majlis Notes – Meeting Transcripts & AI Minutes",
  "short_name": "Majlis",
  "version": "1.0.0",
  "description": "Live transcripts for Google Meet, Microsoft Teams and Zoom (web). Speaker names, highlights, screenshots and AI summaries. No bot joins your call.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "activeTab",
    "tabs",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/wc/*",
        "https://app.zoom.us/wc/*"
      ],
      "js": [
        "adapters.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css",
        "icons/48.png"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Majlis Notes",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "popup.html#settings"
}